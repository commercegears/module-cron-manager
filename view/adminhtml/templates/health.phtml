<?php
/**
 * @var \Softaware\CronManager\Block\Adminhtml\HealthSummary $block
 * @var \Magento\Framework\Escaper $escaper
 */
$report = $block->getReport();
$counts = $block->getCounts24h();
$queue = $block->getQueueCounts();
$overrides = $block->getOverrideCounts();
$cronOk = !$report['not_running'];
?>
<div class="softaware-cron-health">
    <div class="softaware-cron-health-item <?= $cronOk ? '_ok' : '_bad' ?>">
        <span class="softaware-cron-health-label"><?= $escaper->escapeHtml(__('Cron')) ?></span>
        <strong>
            <?php if ($report['minutes_since'] === null): ?>
                <?= $escaper->escapeHtml(__('never ran')) ?>
            <?php elseif ($report['minutes_since'] < 1): ?>
                <?= $escaper->escapeHtml(__('active now')) ?>
            <?php else: ?>
                <?= $escaper->escapeHtml(__('last active %1 min ago', $report['minutes_since'])) ?>
            <?php endif; ?>
        </strong>
        <span class="softaware-cron-health-sub"><?= $escaper->escapeHtml($block->formatUtc($report['last_activity'])) ?></span>
    </div>
    <div class="softaware-cron-health-item">
        <span class="softaware-cron-health-label"><?= $escaper->escapeHtml(__('Last 24 hours')) ?></span>
        <strong>
            <span class="softaware-cron-badge softaware-cron-badge-success"><?= (int) ($counts['success'] ?? 0) ?></span>
            <span class="softaware-cron-badge softaware-cron-badge-error"><?= (int) ($counts['error'] ?? 0) ?></span>
            <span class="softaware-cron-badge softaware-cron-badge-missed"><?= (int) ($counts['missed'] ?? 0) ?></span>
        </strong>
        <span class="softaware-cron-health-sub"><?= $escaper->escapeHtml(__('success / error / missed (kept history only)')) ?></span>
    </div>
    <div class="softaware-cron-health-item">
        <span class="softaware-cron-health-label"><?= $escaper->escapeHtml(__('Queue')) ?></span>
        <strong><?= $escaper->escapeHtml(__('%1 pending, %2 running', (int) ($queue['pending'] ?? 0), (int) ($queue['running'] ?? 0))) ?></strong>
        <span class="softaware-cron-health-sub">
            <?= $escaper->escapeHtml(__('%1 stuck (over %2 min)', count($report['stuck']), $block->getConfig()->getMaxRuntime())) ?>
        </span>
    </div>
    <div class="softaware-cron-health-item <?= $report['failing'] ? '_bad' : '_ok' ?>">
        <span class="softaware-cron-health-label"><?= $escaper->escapeHtml(__('Failing in a row')) ?></span>
        <strong><?= $report['failing'] ? $escaper->escapeHtml(implode(', ', array_slice(array_keys($report['failing']), 0, 3))) : $escaper->escapeHtml(__('none')) ?></strong>
        <span class="softaware-cron-health-sub"><?= $escaper->escapeHtml(__('%1 or more failed runs in a row', $block->getConfig()->getFailureThreshold())) ?></span>
    </div>
    <div class="softaware-cron-health-item">
        <span class="softaware-cron-health-label"><?= $escaper->escapeHtml(__('Changed here')) ?></span>
        <strong><?= $escaper->escapeHtml(__('%1 disabled, %2 rescheduled', $overrides['disabled'], $overrides['rescheduled'])) ?></strong>
        <span class="softaware-cron-health-sub">
            <?= $block->isModuleEnabled()
                ? $escaper->escapeHtml(__('applied'))
                : '<span class="softaware-cron-warn">' . $escaper->escapeHtml(__('not applied: module switched off in the settings')) . '</span>' ?>
        </span>
    </div>
</div>
