<?php
/**
 * @var \CommerceGears\CronManager\Block\Adminhtml\Job\Edit $block
 * @var \Magento\Framework\Escaper $escaper
 */
use CommerceGears\CronManager\Ui\Component\Listing\Column\Duration;
use CommerceGears\CronManager\Ui\Component\Listing\Column\StatusBadge;

$job = $block->getJob();
if (!$job) {
    return;
}
$current = $block->getScheduleInput();
$nextRuns = $block->getNextRuns((string) $job['schedule']);
$badge = static fn (string $status): string => '<span class="commercegears-cron-status '
    . $escaper->escapeHtmlAttr(StatusBadge::getCssClass($status)) . '">'
    . $escaper->escapeHtml(StatusBadge::getLabel($status)) . '</span>';
?>
<div class="commercegears-cron-edit">
    <section class="admin__page-section">
        <div class="admin__page-section-title"><span class="title"><?= $escaper->escapeHtml(__('Job Information')) ?></span></div>
        <table class="admin__table-secondary commercegears-cron-facts">
            <tbody>
            <tr>
                <th scope="row"><?= $escaper->escapeHtml(__('Job Code')) ?></th>
                <td><code><?= $escaper->escapeHtml($job['job_code']) ?></code></td>
            </tr>
            <tr>
                <th scope="row"><?= $escaper->escapeHtml(__('Group')) ?></th>
                <td><?= $escaper->escapeHtml($job['group']) ?></td>
            </tr>
            <tr>
                <th scope="row"><?= $escaper->escapeHtml(__('Module')) ?></th>
                <td><?= $escaper->escapeHtml($job['module']) ?></td>
            </tr>
            <tr>
                <th scope="row"><?= $escaper->escapeHtml(__('Class::Method')) ?></th>
                <td><code><?= $escaper->escapeHtml($job['callback']) ?></code></td>
            </tr>
            <tr>
                <th scope="row"><?= $escaper->escapeHtml(__('State')) ?></th>
                <td><?= /* @noEscape */ $badge($job['is_enabled'] ? 'enabled' : 'disabled') ?></td>
            </tr>
            <tr>
                <th scope="row"><?= $escaper->escapeHtml(__('Default Schedule')) ?></th>
                <td>
                    <code><?= $escaper->escapeHtml($job['original_schedule'] ?: (string) __('none')) ?></code>
                    <?php if ($job['config_path']): ?>
                        <span class="commercegears-cron-muted"><?= $escaper->escapeHtml(__('from the setting %1', $job['config_path'])) ?></span>
                    <?php endif; ?>
                </td>
            </tr>
            <tr>
                <th scope="row"><?= $escaper->escapeHtml(__('Current Schedule')) ?></th>
                <td>
                    <?php if (!$job['is_enabled']): ?>
                        <?= $escaper->escapeHtml(__('None: the job is disabled.')) ?>
                    <?php elseif ($job['schedule'] === ''): ?>
                        <?= $escaper->escapeHtml(__('None: the job only runs when started manually.')) ?>
                    <?php else: ?>
                        <code><?= $escaper->escapeHtml($job['schedule']) ?></code>
                        <?php if ($job['is_overridden']): ?>
                            <span class="commercegears-cron-muted"><?= $escaper->escapeHtml(__('changed by %1 on %2', $job['override_by'] ?: '?', $block->formatUtc($job['override_at']))) ?></span>
                        <?php endif; ?>
                    <?php endif; ?>
                </td>
            </tr>
            <tr>
                <th scope="row"><?= $escaper->escapeHtml(__('Next Runs')) ?></th>
                <td>
                    <?php if ($nextRuns): ?>
                        <ul class="commercegears-cron-runs">
                            <?php foreach ($nextRuns as $run): ?>
                                <li><?= $escaper->escapeHtml($run) ?></li>
                            <?php endforeach; ?>
                        </ul>
                    <?php else: ?>
                        <?= $escaper->escapeHtml(__('None')) ?>
                    <?php endif; ?>
                </td>
            </tr>
            <tr>
                <th scope="row"><?= $escaper->escapeHtml(__('Last Run')) ?></th>
                <td>
                    <?php if (!$job['last_run'] && !$job['last_status']): ?>
                        <?= $escaper->escapeHtml(__('No recent runs')) ?>
                    <?php else: ?>
                        <?= $escaper->escapeHtml($block->formatUtc($job['last_run'])) ?>
                    <?php endif; ?>
                    <?php if ($job['last_status']): ?>
                        <?= /* @noEscape */ $badge((string) $job['last_status']) ?>
                    <?php endif; ?>
                    <?php if ($job['avg_duration'] !== null): ?>
                        <span class="commercegears-cron-muted"><?= $escaper->escapeHtml(__('average duration %1', Duration::format((float) $job['avg_duration']))) ?></span>
                    <?php endif; ?>
                </td>
            </tr>
            </tbody>
        </table>
    </section>

    <section class="admin__page-section">
        <div class="admin__page-section-title"><span class="title"><?= $escaper->escapeHtml(__('State and Schedule')) ?></span></div>
        <form method="post" action="<?= $escaper->escapeUrl($block->getSaveUrl()) ?>" class="commercegears-cron-form" id="commercegears-cron-edit-form"
              data-mage-init='{"validation":{}}'>
            <input type="hidden" name="form_key" value="<?= $escaper->escapeHtmlAttr($block->getFormKey()) ?>"/>
            <fieldset class="admin__fieldset">
                <div class="admin__field">
                    <label class="admin__field-label" for="commercegears-cron-state"><span><?= $escaper->escapeHtml(__('State')) ?></span></label>
                    <div class="admin__field-control">
                        <select id="commercegears-cron-state" name="is_enabled" class="admin__control-select">
                            <option value="1"<?= $job['is_enabled'] ? ' selected' : '' ?>><?= $escaper->escapeHtml(__('Enabled')) ?></option>
                            <option value="0"<?= $job['is_enabled'] ? '' : ' selected' ?>><?= $escaper->escapeHtml(__('Disabled')) ?></option>
                        </select>
                        <div class="admin__field-note">
                            <?= $escaper->escapeHtml(__('A disabled job is no longer queued and its pending entries are removed. It can still be started with Run Now.')) ?>
                        </div>
                    </div>
                </div>
                <div class="admin__field">
                    <label class="admin__field-label" for="commercegears-cron-schedule"><span><?= $escaper->escapeHtml(__('Schedule')) ?></span></label>
                    <div class="admin__field-control">
                        <input type="text" name="schedule" id="commercegears-cron-schedule" class="admin__control-text commercegears-cron-expr"
                               value="<?= $escaper->escapeHtmlAttr($current) ?>" placeholder="*/5 * * * *"
                               data-validate='{"required":true}' aria-describedby="commercegears-cron-schedule-note"/>
                        <div class="commercegears-cron-presets" role="group" aria-label="<?= $escaper->escapeHtmlAttr(__('Common schedules')) ?>">
                            <?php foreach ($block->getPresets() as $expression => $label): ?>
                                <button type="button" class="action-default" data-expr="<?= $escaper->escapeHtmlAttr($expression) ?>"
                                        title="<?= $escaper->escapeHtmlAttr($expression) ?>"><?= $escaper->escapeHtml($label) ?></button>
                            <?php endforeach; ?>
                        </div>
                        <div class="admin__field-option">
                            <input type="checkbox" class="admin__control-checkbox" name="use_default" value="1" id="commercegears-cron-default"
                                   <?= $job['is_overridden'] ? '' : 'checked' ?>/>
                            <label class="admin__field-label" for="commercegears-cron-default">
                                <?= $escaper->escapeHtml(__('Use the default schedule (%1)', $job['original_schedule'] ?: (string) __('none'))) ?>
                            </label>
                        </div>
                        <div class="admin__field-note" id="commercegears-cron-schedule-note">
                            <?= $escaper->escapeHtml(__('Cron expression: minute, hour, day of month, month, day of week. Times are in the store timezone (%1), as Magento schedules them. The change applies from the next cron run.', $block->getTimezone())) ?>
                        </div>
                    </div>
                </div>
            </fieldset>
        </form>
    </section>
    <?php if ($block->canRun()): ?>
        <form method="post" action="<?= $escaper->escapeUrl($block->getRunUrl()) ?>" id="commercegears-cron-run-form" class="no-display">
            <input type="hidden" name="form_key" value="<?= $escaper->escapeHtmlAttr($block->getFormKey()) ?>"/>
        </form>
    <?php endif; ?>
</div>
<script type="text/x-magento-init">
    {"#commercegears-cron-edit-form": {"CommerceGears_CronManager/js/schedule-form": {
        "runTitle": <?= /* @noEscape */ json_encode((string) __('Run %1 now?', $job['job_code']), JSON_HEX_TAG | JSON_HEX_AMP | JSON_HEX_APOS | JSON_HEX_QUOT) ?>,
        "runMessage": <?= /* @noEscape */ json_encode((string) __('The job starts in the background. Its result appears in the schedule.'), JSON_HEX_TAG | JSON_HEX_AMP | JSON_HEX_APOS | JSON_HEX_QUOT) ?>
    }}}
</script>
