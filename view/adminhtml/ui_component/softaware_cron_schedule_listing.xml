<?xml version="1.0" encoding="UTF-8"?>
<listing xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Ui:etc/ui_configuration.xsd">
    <argument name="data" xsi:type="array">
        <item name="js_config" xsi:type="array">
            <item name="provider" xsi:type="string">softaware_cron_schedule_listing.softaware_cron_schedule_listing_data_source</item>
        </item>
    </argument>
    <settings>
        <buttons>
            <button name="jobs">
                <url path="softaware_cron/job/index"/>
                <label translate="true">Cron Jobs</label>
            </button>
            <button name="timeline">
                <url path="softaware_cron/timeline/index"/>
                <class>primary</class>
                <label translate="true">Timeline</label>
            </button>
        </buttons>
        <spinner>softaware_cron_schedule_columns</spinner>
        <deps>
            <dep>softaware_cron_schedule_listing.softaware_cron_schedule_listing_data_source</dep>
        </deps>
    </settings>
    <dataSource name="softaware_cron_schedule_listing_data_source" component="Magento_Ui/js/grid/provider">
        <settings>
            <storageConfig>
                <param name="indexField" xsi:type="string">schedule_id</param>
            </storageConfig>
            <updateUrl path="mui/index/render"/>
            <filterUrlParams>
                <param name="job_code">*</param>
            </filterUrlParams>
        </settings>
        <aclResource>Softaware_CronManager::schedule</aclResource>
        <dataProvider class="Magento\Framework\View\Element\UiComponent\DataProvider\DataProvider" name="softaware_cron_schedule_listing_data_source">
            <settings>
                <requestFieldName>id</requestFieldName>
                <primaryFieldName>schedule_id</primaryFieldName>
            </settings>
        </dataProvider>
    </dataSource>
    <listingToolbar name="listing_top">
        <settings>
            <sticky>true</sticky>
        </settings>
        <bookmark name="bookmarks"/>
        <columnsControls name="columns_controls"/>
        <filters name="listing_filters"/>
        <massaction name="listing_massaction">
            <action name="delete">
                <settings>
                    <confirm>
                        <message translate="true">Delete the selected schedule entries?</message>
                        <title translate="true">Delete entries</title>
                    </confirm>
                    <url path="softaware_cron/schedule/massDelete"/>
                    <type>delete</type>
                    <label translate="true">Delete</label>
                </settings>
            </action>
        </massaction>
        <paging name="listing_paging">
            <settings>
                <pageSize>50</pageSize>
            </settings>
        </paging>
    </listingToolbar>
    <columns name="softaware_cron_schedule_columns">
        <selectionsColumn name="ids">
            <settings>
                <indexField>schedule_id</indexField>
            </settings>
        </selectionsColumn>
        <column name="schedule_id" sortOrder="10">
            <settings>
                <filter>textRange</filter>
                <label translate="true">ID</label>
                <sorting>desc</sorting>
            </settings>
        </column>
        <column name="job_code" sortOrder="20">
            <settings>
                <filter>text</filter>
                <label translate="true">Job Code</label>
            </settings>
        </column>
        <column name="status" class="Softaware\CronManager\Ui\Component\Listing\Column\StatusBadge" component="Magento_Ui/js/grid/columns/column" sortOrder="30">
            <settings>
                <options class="Softaware\CronManager\Model\Source\ScheduleStatus"/>
                <filter>select</filter>
                <bodyTmpl>ui/grid/cells/html</bodyTmpl>
                <label translate="true">Status</label>
            </settings>
        </column>
        <column name="scheduled_at" class="Magento\Ui\Component\Listing\Columns\Date" component="Magento_Ui/js/grid/columns/date" sortOrder="40">
            <settings>
                <filter>dateRange</filter>
                <dataType>date</dataType>
                <label translate="true">Scheduled</label>
            </settings>
        </column>
        <column name="executed_at" class="Magento\Ui\Component\Listing\Columns\Date" component="Magento_Ui/js/grid/columns/date" sortOrder="50">
            <settings>
                <filter>dateRange</filter>
                <dataType>date</dataType>
                <label translate="true">Started</label>
            </settings>
        </column>
        <column name="finished_at" class="Magento\Ui\Component\Listing\Columns\Date" component="Magento_Ui/js/grid/columns/date" sortOrder="60">
            <settings>
                <filter>dateRange</filter>
                <dataType>date</dataType>
                <label translate="true">Finished</label>
            </settings>
        </column>
        <column name="duration" class="Softaware\CronManager\Ui\Component\Listing\Column\Duration" sortOrder="70">
            <settings>
                <label translate="true">Duration</label>
            </settings>
        </column>
        <column name="messages" class="Softaware\CronManager\Ui\Component\Listing\Column\Message" sortOrder="80">
            <settings>
                <filter>text</filter>
                <label translate="true">Message</label>
                <sortable>false</sortable>
            </settings>
        </column>
        <column name="created_at" class="Magento\Ui\Component\Listing\Columns\Date" component="Magento_Ui/js/grid/columns/date" sortOrder="90">
            <settings>
                <filter>dateRange</filter>
                <dataType>date</dataType>
                <label translate="true">Queued</label>
                <visible>false</visible>
            </settings>
        </column>
    </columns>
</listing>
