<?xml version="1.0"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Config:etc/system_file.xsd">
    <system>
        <section id="softaware_cron_manager" translate="label" type="text" sortOrder="45" showInDefault="1">
            <label>Cron Manager</label>
            <tab>softaware</tab>
            <resource>Softaware_CronManager::config</resource>
            <group id="general" translate="label" type="text" sortOrder="10" showInDefault="1">
                <label>General</label>
                <field id="enabled" translate="label comment" type="select" sortOrder="10" showInDefault="1">
                    <label>Enabled</label>
                    <source_model>Magento\Config\Model\Config\Source\Yesno</source_model>
                    <comment>When off, disabled jobs and schedule changes made here are ignored (every job runs on its default schedule), and the health checks and e-mails stop. The job and schedule pages stay available.</comment>
                </field>
                <field id="php_binary" translate="label comment" type="text" sortOrder="20" showInDefault="1">
                    <label>PHP Binary for "Run Now"</label>
                    <backend_model>Softaware\CronManager\Model\Config\Backend\PhpBinary</backend_model>
                    <comment>Absolute path of the PHP command-line binary used to start jobs in the background, e.g. /usr/bin/php8.3 (the file name must start with "php"). Leave empty to detect it.</comment>
                </field>
            </group>
            <group id="stuck" translate="label" type="text" sortOrder="20" showInDefault="1">
                <label>Stuck Jobs</label>
                <field id="max_runtime" translate="label comment" type="text" sortOrder="10" showInDefault="1">
                    <label>Maximum Runtime (Minutes)</label>
                    <validate>validate-digits validate-greater-than-zero</validate>
                    <comment>A job still "running" after this long is treated as stuck (its process most likely died).</comment>
                </field>
                <field id="auto_mark" translate="label comment" type="select" sortOrder="20" showInDefault="1">
                    <label>Mark Stuck Jobs as Failed Automatically</label>
                    <source_model>Magento\Config\Model\Config\Source\Yesno</source_model>
                    <comment>Checked every 5 minutes by the softaware_cron_manager_health job. Magento itself only does this after a day.</comment>
                </field>
            </group>
            <group id="health" translate="label" type="text" sortOrder="30" showInDefault="1">
                <label>Health Warnings in the Admin</label>
                <field id="not_running_minutes" translate="label comment" type="text" sortOrder="10" showInDefault="1">
                    <label>Warn When Cron Has Not Run For (Minutes)</label>
                    <validate>validate-digits validate-zero-or-greater</validate>
                    <comment>0 turns this warning off.</comment>
                </field>
                <field id="failure_threshold" translate="label comment" type="text" sortOrder="20" showInDefault="1">
                    <label>Warn When a Job Fails This Many Times in a Row</label>
                    <validate>validate-digits validate-zero-or-greater</validate>
                    <comment>0 turns this warning off.</comment>
                </field>
                <field id="ignore_jobs" translate="label comment" type="textarea" sortOrder="30" showInDefault="1">
                    <label>Ignore These Jobs</label>
                    <comment><![CDATA[Job codes separated by commas or new lines; * matches any text (e.g. <code>amazon_*</code>). These jobs are left out of the warnings and the failure e-mails, and are not marked as failed when they run longer than the maximum runtime.]]></comment>
                </field>
            </group>
            <group id="notify" translate="label" type="text" sortOrder="40" showInDefault="1">
                <label>Failure E-mails</label>
                <field id="enabled" translate="label" type="select" sortOrder="10" showInDefault="1">
                    <label>Send E-mails About Failed Jobs</label>
                    <source_model>Magento\Config\Model\Config\Source\Yesno</source_model>
                </field>
                <field id="recipients" translate="label comment" type="text" sortOrder="20" showInDefault="1">
                    <label>Send To</label>
                    <comment>One or more addresses, separated by commas.</comment>
                    <depends>
                        <field id="enabled">1</field>
                    </depends>
                </field>
                <field id="identity" translate="label" type="select" sortOrder="30" showInDefault="1">
                    <label>Sender</label>
                    <source_model>Magento\Config\Model\Config\Source\Email\Identity</source_model>
                    <depends>
                        <field id="enabled">1</field>
                    </depends>
                </field>
                <field id="template" translate="label" type="select" sortOrder="40" showInDefault="1">
                    <label>E-mail Template</label>
                    <source_model>Magento\Config\Model\Config\Source\Email\Template</source_model>
                    <depends>
                        <field id="enabled">1</field>
                    </depends>
                </field>
                <field id="interval" translate="label comment" type="text" sortOrder="50" showInDefault="1">
                    <label>At Most One E-mail Every (Minutes)</label>
                    <validate>validate-digits validate-greater-than-zero</validate>
                    <comment>Failures in between are collected into the next e-mail.</comment>
                    <depends>
                        <field id="enabled">1</field>
                    </depends>
                </field>
            </group>
        </section>
    </system>
</config>
